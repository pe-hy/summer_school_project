# runtime database (NoSQL document store, created on first run)
/data/
# tokens written by seed_demo.py
seed_tokens.txt
__pycache__/
*.pyc
.venv/
/data/*.lock
# organiser key written by deploy/deploy_pythonanywhere.py
deploy/.admin_key
deploy/.pa_token
# /admin editor password (public repo: never commit it)
deploy/.edit_password
# one-step undo written by the /admin editor
*.md.bak
# instructor-only material — NEVER commit or serve (public repo!)
workshop/INSTRUCTOR_NOTES.md
# answer key for the unlabeled pool (instructor only)
workshop/data/_instructor/
# instructor-only: names the source corpora / links to the original labels
workshop/data/README.md
scripts/build_data.py
# instructor-only: reads the pool answer key in workshop/data/_instructor/
scripts/build_labeled_examples.py
# instructor-only: Haiku labels for pool messages (a partial answer key) + the baseline
workshop/baseline/

# QuickJS test harnesses: local tooling, includes a compiled wheel
/tests/
